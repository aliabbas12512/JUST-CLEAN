# --- Required: Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the cron route and payment callbacks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required in production ---
NEXT_PUBLIC_SITE_URL=https://your-domain.sa
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional: online payments via Moyasar (partner subscriptions). Leave empty to use manual bank transfer only. ---
MOYASAR_SECRET_KEY=

# --- Optional: branding ---
NEXT_PUBLIC_BRAND_NAME_AR=جست كلين
NEXT_PUBLIC_BRAND_NAME_UR=جسٹ کلین
NEXT_PUBLIC_BRAND_NAME_EN=Just Clean
